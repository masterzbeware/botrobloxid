-- ============ AUTO SMELTING ============
local smeltingStarted = false

SmeltingEvent.OnClientEvent:Connect(function(action, data)
    if not autoSmeltingEnabled then return end
    
    if action == "OpenMenu" and data then
        -- Pilih item pertama untuk di-smelt
        for barName, info in pairs(data) do
            print("[L-01] 🔥 Memilih:", barName)
            SmeltingEvent:FireServer("RequestCraft", barName)
            break
        end
    elseif action == "StartMinigame" and data then
        task.wait(0.1)
        SmeltingEvent:FireServer("StopProcess", true)
    end
end)

local function triggerSmeltingPrompt()
    -- Cari prompt smelting di workspace
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("ProximityPrompt") then
            local name = v.Name:lower()
            if name:find("smelt") or name:find("furnace") or name:find("forge") then
                pcall(function()
                    v.MaxActivationDistance = 15
                    v:InputHoldBegin()
                    task.wait(0.15)
                    v:InputHoldEnd()
                end)
                return
            end
        end
    end
end

local function startAutoSmelting()
    task.spawn(function()
        while autoSmeltingEnabled do
            triggerSmeltingPrompt()
            task.wait(4)
        end
    end)
end

