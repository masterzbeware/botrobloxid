-- ============ VARIABLES ============
local autoMiningEnabled = false
local autoCuciEnabled = false
local autoSmeltingEnabled = false

-- ============ AUTO MINING ============
MiningEvent.OnClientEvent:Connect(function(action, prompt, data)
    if not autoMiningEnabled then return end
    if action == "OpenMinigame" and data then
        task.wait(0.1)
        MiningEvent:FireServer("StopProcess", true)
    end
end)

local function triggerMiningPrompt()
    local rocks = Workspace:FindFirstChild("Rocks")
    if not rocks then return end
    for _, rock in ipairs(rocks:GetChildren()) do
        local rockPrompt = rock:FindFirstChild("RocksPrompt")
        if rockPrompt then
            local prompt = rockPrompt:FindFirstChild("ProximityPrompt")
            if prompt then
                pcall(function()
                    prompt.MaxActivationDistance = 15
                    prompt:InputHoldBegin()
                    task.wait(0.15)
                    prompt:InputHoldEnd()
                end)
                return
            end
        end
    end
end

local function startAutoMining()
    task.spawn(function()
        while autoMiningEnabled do
            triggerMiningPrompt()
            task.wait(3)
        end
    end)
end

