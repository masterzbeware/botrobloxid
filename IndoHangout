-- KYRO HUB AUTO FISHING + MINING + SHOP + ROD SYSTEM

local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()

local Window = Fluent:CreateWindow({
    Title = "Kyro Hub",
    SubTitle = "Premium System",
    TabWidth = 160,
    Size = UDim2.fromOffset(500, 350),
    Acrylic = true,
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.LeftControl
})

-- ================= TAB =================
local Tabs = {
    AutoFishing = Window:AddTab({ Title = "FISHING" }),
    Mining = Window:AddTab({ Title = "MINING" }),
    Shop = Window:AddTab({ Title = "SHOP" })
}

-- ================= SERVICES =================
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local RodEvent = ReplicatedStorage.Events.RemoteEvent.Rod
local PickaxeEvent = ReplicatedStorage.Events.RemoteEvent.Pickaxe

-- ================= VARIABLES =================
local AutoFishingEnabled = false
local isFishing = false
local catchCount = 0

local AutoMiningEnabled = false
local miningSpeed = 0.4

local CrystalESPEnabled = false
local crystalHighlights = {}

-- ================= FISHING =================
local function getRod()
    return LocalPlayer.Backpack:FindFirstChild("Basic Rod")
        or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Basic Rod"))
end

local function makeWhiteBarFullWidth()
    local gui = LocalPlayer:FindFirstChild("PlayerGui")
    if not gui then return end

    local reeling = gui:FindFirstChild("Reeling")
    if not reeling or not reeling.Enabled then return end

    local frame = reeling:FindFirstChild("MainFrame")
    if not frame then return end

    local inner = frame:FindFirstChild("Frame")
    if not inner then return end

    local white = inner:FindFirstChild("WhiteBar")
    local red = inner:FindFirstChild("RedBar")

    if white then
        white.Size = UDim2.new(1, 0, white.Size.Y.Scale, 0)
        white.Position = UDim2.new(0, 0, white.Position.Y.Scale, 0)
    end

    if red then
        red.Size = UDim2.new(0.02, 0, red.Size.Y.Scale, 0)
    end
end

local function autoClick()
    while AutoFishingEnabled and isFishing do
        pcall(function()
            local vim = game:GetService("VirtualInputManager")
            vim:SendKeyEvent(true, Enum.KeyCode.Space, false, nil)
            task.wait(0.01)
            vim:SendKeyEvent(false, Enum.KeyCode.Space, false, nil)
        end)
        task.wait(0.05)
    end
end

task.spawn(function()
    while true do
        if AutoFishingEnabled and isFishing then
            makeWhiteBarFullWidth()
        end
        task.wait(0.1)
    end
end)

if getRod() then
    RodEvent.OnClientEvent:Connect(function(action, rodObj)
        if action == "StartReeling" then
            isFishing = true
            makeWhiteBarFullWidth()
            task.spawn(autoClick)

        elseif action == "StartShake" then
            catchCount += 1
            isFishing = true
            task.spawn(autoClick)

        elseif action == "StopShake" then
            isFishing = false
        end
    end)
end

local function cast()
    if not AutoFishingEnabled or isFishing then return end

    local rod = getRod()
    if not rod then return end

    isFishing = true
    RodEvent:FireServer("Throw", nil, rod)

    task.wait(15)
    isFishing = false
end

task.spawn(function()
    while AutoFishingEnabled do
        if not isFishing then
            cast()
        end
        task.wait(math.random(3, 6))
    end
end)

-- ================= FISHING UI =================
Tabs.AutoFishing:AddParagraph({
    Title = "Auto Fishing",
    Content = "Fishing System Active"
})

Tabs.AutoFishing:AddToggle("AutoFishingToggle", {
    Title = "Auto Fishing",
    Default = false
}):OnChanged(function(v)
    AutoFishingEnabled = v
    isFishing = false
end)

Tabs.AutoFishing:AddButton({
    Title = "Sell All Fish",
    Callback = function()
        local args = {"SellFish", "Sell All"}

        game:GetService("ReplicatedStorage")
            :WaitForChild("Events")
            :WaitForChild("RemoteFunction")
            :WaitForChild("SellFish")
            :InvokeServer(unpack(args))
    end
})

-- ================= MINING =================
local function miningLoop()
    while AutoMiningEnabled do
        PickaxeEvent:FireServer("Hit")
        task.wait(miningSpeed)
    end
end

Tabs.Mining:AddParagraph({
    Title = "Auto Mining",
    Content = "Mining + Crystal System"
})

Tabs.Mining:AddSlider("MiningSpeed", {
    Title = "Mining Speed",
    Default = 0.4,
    Min = 0.1,
    Max = 1,
    Rounding = 2
}):OnChanged(function(v)
    miningSpeed = v
end)

Tabs.Mining:AddToggle("MiningToggle", {
    Title = "Auto Mining",
    Default = false
}):OnChanged(function(v)
    AutoMiningEnabled = v
    if v then
        task.spawn(miningLoop)
    end
end)

-- ================= CRYSTAL ESP =================
local function addESP(obj)
    if crystalHighlights[obj] then return end
    if not obj:IsA("BasePart") then return end

    local h = Instance.new("Highlight")
    h.FillColor = Color3.fromRGB(0, 255, 255)
    h.OutlineColor = Color3.fromRGB(255, 255, 255)
    h.FillTransparency = 0.4
    h.OutlineTransparency = 0
    h.Adornee = obj
    h.Parent = obj

    crystalHighlights[obj] = h
end

local function clearESP()
    for _, v in pairs(crystalHighlights) do
        v:Destroy()
    end
    table.clear(crystalHighlights)
end

local function updateCrystals()
    local folder = workspace:FindFirstChild("MapContent")
        and workspace.MapContent:FindFirstChild("Crystals")

    if not folder then return end

    for _, v in ipairs(folder:GetChildren()) do
        if v:IsA("BasePart") then
            addESP(v)
        end
    end
end

Tabs.Mining:AddToggle("CrystalESP", {
    Title = "Crystal Highlight",
    Default = false
}):OnChanged(function(v)
    CrystalESPEnabled = v

    if v then
        task.spawn(function()
            while CrystalESPEnabled do
                updateCrystals()
                task.wait(1)
            end
        end)
    else
        clearESP()
    end
end)

